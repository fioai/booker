# Local development placeholders only. Never put production credentials here.
BOOKING_ENGINE_ENV=local
DATABASE_URL=postgresql://replace_me_local_user:replace_me_local_password@127.0.0.1:15432/replace_me_local_database
# Staging and production require real credentials, a non-loopback host, and exactly
# `?sslmode=verify-full`; local Compose intentionally uses no database TLS.
DATABASE_SCHEMA=public
POSTGRES_DB=replace_me_local_database
POSTGRES_USER=replace_me_local_user
POSTGRES_PASSWORD=replace_me_local_password
POSTGRES_PORT=15432
PORT=13000
API_PORT=13000
HOST=127.0.0.1
BOOKING_ENGINE_ORGANIZATION_ID=sample-tenant
BOOKING_ENGINE_PROPERTY_ID=sample-bungalow
ADMIN_ORIGIN=http://127.0.0.1:13000
SECURE_COOKIES=false
# Host startup is unseeded by default. The Compose app owns its local sample settings.
BOOKING_ENGINE_SAMPLE_DATA=false
MAILPIT_SMTP_PORT=11025
MAILPIT_UI_PORT=18025
