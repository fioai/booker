{
  "name": "@booking-engine/booking-engine",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=22.23.1 <23"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc -b --pretty false && tsc --noEmit -p tsconfig.tests.json --pretty false",
    "test": "vitest run packages apps/api tests/hardening",
    "test:integration": "node scripts/run-integration-tests.mjs",
    "start": "node scripts/run-api.mjs",
    "build": "tsc -b --pretty false",
    "check:env": "node scripts/check-env.mjs --template",
    "check:env:runtime": "node scripts/check-env.mjs --runtime",
    "check:database": "node scripts/check-database.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "smoke:request-to-book": "node scripts/smoke-request-to-book.mjs",
    "backup:restore": "node scripts/backup-restore-check.mjs",
    "scan:secrets": "node scripts/check-secrets.mjs",
    "scan:history": "node scripts/check-secrets-history.mjs",
    "audit:dependencies": "corepack pnpm audit --prod --audit-level high",
    "docker:clean-room": "node scripts/docker-clean-room.mjs",
    "check:architecture": "node scripts/check-architecture-boundaries.mjs",
    "check:sdk-package": "node scripts/check-sdk-package.mjs",
    "check:public-boundary": "node scripts/check-public-contract-boundary.mjs",
    "check:public-contract": "node scripts/check-public-contract-boundary.mjs && vitest run packages/sdk-typescript/test/public-contract.test.ts --reporter=dot"
  },
  "devDependencies": {
    "@eslint/js": "9.29.0",
    "@types/node": "26.1.1",
    "@types/pg": "^8.20.0",
    "eslint": "9.29.0",
    "globals": "16.2.0",
    "pg": "^8.22.0",
    "prettier": "3.5.3",
    "typescript": "5.8.3",
    "typescript-eslint": "8.34.1",
    "vitest": "3.2.4"
  }
}
